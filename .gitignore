# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# local media uploads (S3 in production)
/public/uploads

# terraform
infra/aws/.terraform/
infra/aws/*.tfstate*
infra/aws/*.tfvars
!infra/aws/example.tfvars
infra/aws/.terraform.lock.hcl
/loadtest-results

# demo keys (generated by npm run demo -- setup)
/examples/demo-config.json

# native SDK + example app build output
.build/
.swiftpm/
.gradle/
build/
local.properties
*.xcodeproj/
DerivedData/
.kotlin/

# Expo continuous native generation (npx expo prebuild)
/examples/react-native-demo/ios/
/examples/react-native-demo/android/
/examples/react-native-demo/.expo/
