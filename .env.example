DATABASE_URL="postgresql://USER@localhost:5432/brazecopy"
APP_BASE_URL="http://localhost:3000"

# Session + tracking-URL + SDK user-token signing secret. Production refuses to
# start without a random value of 32+ characters.
TRACKING_SECRET="generate-a-long-random-string"

# ---------------------------------------------------------------------------
# Everything below is OPTIONAL. On AWS the Terraform stack (infra/aws) sets
# these for you; locally the Settings page covers the credentials.
# ---------------------------------------------------------------------------

# AWS SES — on AWS leave the keys blank: the ECS task role is used
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_FROM_EMAIL=""
SES_FROM_NAME=""
SES_CONFIGURATION_SET=""
SES_MAX_SEND_RATE=""
# Comma-separated SNS topic ARNs allowed to post to /api/webhooks/ses
SES_SNS_TOPIC_ARNS=""

# Web Push (fallback — prefer "Generate VAPID keys" on the Settings page)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# FCM — the service-account JSON itself (e.g. from Secrets Manager) or a file path
FCM_SERVICE_ACCOUNT_JSON=""
FCM_SERVICE_ACCOUNT_PATH=""

# APNs direct (token auth). APNS_PRIVATE_KEY = contents of AuthKey_XXXX.p8
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID=""
APNS_PRIVATE_KEY=""
APNS_PRODUCTION="true"
APNS_CONCURRENCY="200"

# S3 (on AWS: set by Terraform)
MEDIA_S3_BUCKET=""
MEDIA_PUBLIC_BASE_URL=""   # CloudFront domain for the media bucket
EXPORT_S3_BUCKET=""

# Console sign-in: OIDC single sign-on (or configure on the Settings page)
OIDC_ISSUER=""
OIDC_CLIENT_ID=""
OIDC_CLIENT_SECRET=""
OIDC_ALLOWED_DOMAINS=""     # comma-separated
OIDC_AUTO_PROVISION="false"
OIDC_DEFAULT_ROLE="USER"
OIDC_ADMIN_GROUPS=""        # IdP groups claim values that grant ADMIN

# SAML 2.0 single sign-on (e.g. PingFederate / PingOne), alternative to OIDC. Or Settings → SSO — SAML.
# SP metadata: <APP_BASE_URL>/api/auth/sso/saml/metadata   ACS: <APP_BASE_URL>/api/auth/sso/saml/acs
SAML_ENTRY_POINT=""         # IdP SSO URL, e.g. https://sso.example.com/idp/SSO.saml2
SAML_IDP_CERT=""            # IdP signing certificate (PEM or base64 body)
SAML_IDP_ISSUER=""          # IdP entity ID (recommended)
SAML_ADMIN_GROUPS=""        # memberOf / groups values that grant ADMIN
SAML_ALLOWED_DOMAINS=""
SAML_AUTO_PROVISION="false"

# SMS & WhatsApp via Twilio (or Settings → SMS & WhatsApp). Webhook: <APP_BASE_URL>/api/webhooks/twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""   # MG… (recommended) — or TWILIO_FROM
TWILIO_FROM=""                    # +447700900123
TWILIO_WHATSAPP_FROM=""           # approved WhatsApp sender, +14155238886

# Integration alerts (Slack / Teams incoming webhook); also configurable in Settings → Integration health
ALERT_WEBHOOK_URL=""

# Two-step verification: key that encrypts TOTP secrets (set explicitly in production)
MFA_ENCRYPTION_KEY=""
REQUIRE_MFA="false"
ENFORCE_SSO="false"
SESSION_DAYS="7"

# Client SDK
SDK_CORS_ORIGINS="*"             # browser origins allowed to call /api/sdk/v1
SDK_REQUIRE_USER_TOKEN="false"   # true = SDK calls naming an externalId need a token from POST /api/v1/sdk-tokens

# API rate limits (requests per minute per key)
API_RATE_LIMIT_SERVER_PER_MIN="6000"
API_RATE_LIMIT_SDK_PER_MIN="60000"
API_RATE_LIMIT_ANON_PER_MIN="120"

# Data retention in days (blank = keep forever)
MESSAGE_RETENTION_DAYS=""
EVENT_RETENTION_DAYS=""
AUDIT_RETENTION_DAYS="400"
JOB_RETENTION_DAYS="7"

# Recommendations & feeds
RECO_READ_EVENTS="article_read,Article Read,content_viewed,Content Viewed"
RECO_HALF_LIFE_HOURS="12"
RECO_WINDOW_HOURS="72"
FEED_AUTOSEND_MAX_AGE_MIN="120"

# Operations
METRICS_EMF="false"       # true on AWS: CloudWatch embedded metrics from the worker
DISPATCH_ENV="dev"
EXPORT_S3_DAILY="false"   # true: yesterday's events/messages to EXPORT_S3_BUCKET every day
SESSION_CHECK_TTL_MS="15000"

# Worker
DB_POOL_SIZE=""           # worker: ≥ WORKER_BATCH_SIZE + 5
DB_POOL_TIMEOUT="30"
LAUNCH_PARTITIONS="8"     # parallel fan-out ranges per campaign launch
WORKER_POLL_INTERVAL_MS="1000"
WORKER_BATCH_SIZE="25"
WORKER_COUNT="1"          # number of worker tasks — each takes 1/N of the SES send rate
WORKER_HEALTH_PORT="8081"
SEND_CONCURRENCY="50"
