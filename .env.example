DATABASE_URL="postgresql://USER@localhost:5432/brazecopy"
APP_BASE_URL="http://localhost:3000"

# Session + tracking-URL signing secret — set a long random string in production
TRACKING_SECRET="generate-a-long-random-string"

# ---------------------------------------------------------------------------
# Everything below is OPTIONAL — SES, VAPID and FCM credentials can all be
# configured from the admin UI (Settings page) instead. Env vars act as a
# fallback when no value is stored in the database.
# ---------------------------------------------------------------------------

# AWS SES (fallback — prefer the Settings page)
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_FROM_EMAIL=""
SES_FROM_NAME=""
SES_CONFIGURATION_SET=""
SES_MAX_SEND_RATE=""

# Web Push (fallback — prefer "Generate VAPID keys" on the Settings page)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# FCM (fallback — prefer uploading the service-account JSON on the Settings page)
FCM_SERVICE_ACCOUNT_PATH=""

# Worker
WORKER_POLL_INTERVAL_MS="1000"
WORKER_BATCH_SIZE="25"
